# ======================================================================
# PulseFlow – Environment Configuration
# ======================================================================
# Author      : Bhagwat Chate
# Module      : .env.example
# Purpose     : Reference configuration for deployment engineers
# Usage       : Copy this file → rename to `.env` and fill real values.
# Notes       : Secrets must come from AWS Secrets Manager in PROD.
# ======================================================================

# ----------------------------------------------------------------------
# General Environment
# ----------------------------------------------------------------------
PULSEFLOW_APP_ENV=dev               # dev | prod — defines runtime behavior (logging, configs)
AWS_REGION=xxxxxxxxx                # AWS region where secrets are stored (e.g., ap-south-1)
AWS_SECRET_NAME=xxxxxxxxx           # Name of secret in AWS Secrets Manager containing API keys

# ----------------------------------------------------------------------
# API Keys (retrieved from .env in DEV, AWS Secrets in PROD)
# ----------------------------------------------------------------------
GROQ_API_KEY=xxxxxxxxx              # Groq API key for LLM inference
GOOGLE_API_KEY=xxxxxxxxx            # Google API key for search / knowledge APIs
OPENAI_API_KEY=xxxxxxxxx            # OpenAI key for embeddings & completions

# ----------------------------------------------------------------------
# Database / Vector Store Configuration
# ----------------------------------------------------------------------
ASTRA_DB_API_ENDPOINT=xxxxxxxxx     # AstraDB API endpoint (https://xxxx.apps.astra.datastax.com)
ASTRA_DB_APPLICATION_TOKEN=xxxxxxxxx # AstraDB access token
ASTRA_DB_KEYSPACE=xxxxxxxxx         # AstraDB keyspace name (e.g., pulseflow_keyspace)
ASTRA_DB_COLLECTION=xxxxxxxxx       # AstraDB collection name (e.g., pulseflow_collection)

# ----------------------------------------------------------------------
# LangSmith / LangChain Observability
# ----------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true           # Enables LangSmith v2 tracing
LANGCHAIN_PROJECT=xxxxxxxxx         # Project name for LangSmith dashboards
LANGCHAIN_API_KEY=xxxxxxxxx         # API key for LangSmith observability

# ----------------------------------------------------------------------
# Deployment Notes
# ----------------------------------------------------------------------
# For local dev: Keep `.env` file in project root — never commit real keys.
# For production (ECS / Lambda / EC2): Inject via AWS Secrets Manager + `AWS_SECRET_NAME`
# For containerized deployments: Mount via Docker / ECS task definition environment section.
# Verify with:python -m prod_assistant.core.bootstrap (should log: "Environment bootstrapped successfully")
